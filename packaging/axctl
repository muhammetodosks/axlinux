#!/usr/bin/env python3
"""AXlinux komut satir araci.

Tek dogruluk kaynagi: hem RPM paketi hem install.sh BU dosyayi
kurar. Once iki farkli sarmalayici vardi:

  RPM      #!/bin/sh + python3 -c '...'
  install.sh   #!/usr/bin/env python3 + normal betik

`python3 -c` yontemi ek olarak bir hata uretiyordu: bu modda
sys.argv[0] degeri "-c" olur, dolayisiyla click yardim ciktisini
"Usage: -c [OPTIONS]" olarak gosterir. Betik dosyasi olarak
calistirildiginda sys.argv[0] dogru dosya yoludur ve click
dogru program adini gorur.

Python paketi /usr/lib/axlinux altinda kurulur ve kaynak agaciyla
birlikte tasinabilmesi icin sys.path'e elle eklenir.
"""
import sys

sys.path.insert(0, "/usr/lib/axlinux")

from axctl.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
