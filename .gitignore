# Derlenen ciktilar
# NOT: desenler kok dizine gore yazilir. Duz "axdaemon" yazmak
# src/go/axdaemon/ kaynak dizinini de dislamak demektir.
*.o
*.tmp
*.a
/bin/
/src/go/axdaemon/axdaemon
/src/go/axlog/axlog
__pycache__/
*.pyc
*.pyo

# uretilir: kernel BTF'den cikarilir, depoya girmez
vmlinux.h
*.bpf.o
/var/log/axlinux/

# python
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Gecici teşhis araclari (cmd/mapdump, cmd/mapcmp). Sorun
# tespitinde kullanildi, uretim kodu degildir.
# NOT: kok dizine gore yazilir, onceki "axlinux/src/..." yazimi
# yanlitti ve hicbir seyi dislamiyordu.
/src/go/axdaemon/cmd/mapcmp/
/src/go/axdaemon/cmd/mapdump/

# Test artiklari. verify_all.sh gecici dosyalari /tmp altinda
# uretir, ama bir testin yarida kesilmesi veya TMPDIR degismesi
# durumunda repo icinde kalabilir; git add -A bunlari yakalayip
# kalici olarak kaydederdi.
/ax-write-test.*
/ax-write-ok.*
/axd-verify.log
/coverage.out

# editor / OS
*.swp
*~
.idea/
.vscode/
.DS_Store

# gecici test artiklari
.wtest

# Bytecode buraya yonlendirilir; kaynak agaci temiz kalsin
.build/

# rpmbuild calisma dizini (Makefile uretir)
.rpmbuild/

# SELinux modul derleme artiklari.
#
# ONEMLI: axlinux.pp ASLA repoda tutulmazdi degil, tutuldugu
# surece "make rpm" yalnizca "all" cagrdigindan mevcut .pp'yi
# "guncel" sanip DERLEMeyi atlardi; RPM'e bayat modul
# paketleniyordu. Fedora 43'te olculen bozuk modul: 91.660 bayt,
# icinde 0 tip ve 0 dosya-baglami kurali - SELinux korumasi
# sessizce hic kurulmuyordu. Modul her zaman "clean" + "all"
# ile sifirdan derlenir; burasi sadece cikti dizinidir.
packaging/fedora/*.pp
packaging/fedora/tmp/

# Derlenmis paketler repoya GIRMEZ. CI her commit'te yeniden uretir
# ve icerigini dogrular; hazir paket commit'lemek (a) boyutu
# gereksiz buyutur, (b) kaynakla eskimesi riskini tasir.
*.rpm
*.deb

# Yerel dagitim klasoru (paket + belge kopyalari)
downloads/
